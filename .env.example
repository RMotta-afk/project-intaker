# SQLite path, relative to prisma/schema.prisma.
DATABASE_URL="file:./intakes.db"
# Server-only OpenRouter settings. Leave the key empty to exercise failure handling.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# The worker loads a server-side module exporting generateTriage.
WORKER_ADAPTER_MODULE=./src/ai/provider/generate.ts
# For controlled local tests only: ./scripts/fake-worker-adapter.ts
# Never commit a real .env file.
